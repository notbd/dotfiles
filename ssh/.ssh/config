# Coding agents (Claude Code, Codex) set GH_CONFIG_DIR: their ssh never reaches 1Password
Match exec "test -n \"$GH_CONFIG_DIR\""
  IdentityAgent none
  IdentitiesOnly yes

# No terminal (an app's background git fetch, a script, an agent): no 1Password either.
# Only ssh started from a terminal I type in asks for Touch ID.
Match exec "ps -o tty= -p $PPID | grep -q '?'"
  IdentityAgent none
  IdentitiesOnly yes

Host *
  IdentityAgent "~/.1password/agent.sock"
  UserKnownHostsFile ~/.ssh/known_hosts ~/.ssh/known_hosts.github
